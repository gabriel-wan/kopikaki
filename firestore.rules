rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Readable by the caller who booked it and by everyone who has since joined.
    match /meetups/{meetupId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
          || ('participantIds' in resource.data
            && request.auth.uid in resource.data.participantIds));
      allow write: if false;
    }

    match /kakis/{candidateId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /groups/{candidateId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /activities/{candidateId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /availability/{availabilityId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
